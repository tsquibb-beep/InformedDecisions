// InformedDecisions — settings. Reload in game with the dev console: idec reload
//
// Copy this file to your save folder to keep your settings through mod updates:
//   %APPDATA%\SlayTheSpire2\InformedDecisions.config.jsonc
// That copy is read in preference to this one.
//
// Gem positions are [x, y] in the game's gem's own units: the energy gem is 64 x 64 and the star
// gem 58 x 58, with [0, 0] at the gem's top-left corner. Each small gem is centred on that point.
{
    // Master switch for the whole mod.
    "enabled": true,

    // Show the card's normal cost in a small gem behind its cost when an effect has changed it
    // (Void Form, Corruption, Bullet Time...). Cost cuts from upgrades are not shown.
    "showOriginalCost": true,

    // Show cards that will be played more than once (Replay).
    "showReplay": true,

    // Also count extra plays from powers and relics (Echo Form, Burst, Duplication...),
    // not only Replay on the card itself.
    "replayIncludesPowers": true,

    // Size of the small gems compared with the real ones, and how bright the small gem is
    // (1 = as bright as the real gem; the number itself is never dimmed).
    "originalCostScale": 0.62,
    "originalStarCostScale": 0.7,
    "originalCostGemShade": 0.8,
    "originalCostOffset": [60, 6],
    "originalStarCostOffset": [50, 50],

    // "R2" in a small gem by the cost for a card that will be played 2 extra times. It is
    // smaller, darker and slightly see-through so it stays in the background.
    "replayGem": true,
    "replayGemScale": 0.58,
    "replayGemShade": 0.6,
    "replayGemOpacity": 0.85,
    "replayGemOffset": [54, 54],

    // Card edges stacked behind a card that will be played more than once, up to replayStackMax.
    // Where each edge sits relative to the one in front ([right, down], in card units; the card is
    // 300 x 422), and how much darker each one is (0 to 0.3).
    "replayStack": true,
    "replayStackMax": 2,
    "replayStackOffset": [7, -9],
    "replayStackShade": 0.2
}
