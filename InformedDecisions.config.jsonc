// InformedDecisions — settings. Reload in game with the dev console: idec reload
//
// Copy this file to your save folder to keep your settings through mod updates:
//   %APPDATA%\SlayTheSpire2\InformedDecisions.config.jsonc
// That copy is read in preference to this one.
//
// Gem positions are [x, y] in the game's gem's own units: the energy gem is 64 x 64 and the star
// gem 58 x 58, with [0, 0] at the gem's top-left corner. Each small gem is centred on that point.
{
    // Master switch for the whole mod.
    "enabled": true,

    // Show the card's normal cost in a small gem behind its cost when an effect has changed it
    // (Void Form, Corruption, Bullet Time...). Cost cuts from upgrades are not shown.
    "showOriginalCost": true,

    // Show cards that will be played more than once (Replay).
    "showReplay": true,

    // Also count extra plays from powers and relics (Echo Form, Burst, Duplication...),
    // not only Replay on the card itself.
    "replayIncludesPowers": true,

    // Size of the small gems compared with the real ones, and how bright the small gem is
    // (1 = as bright as the real gem; the number itself is never dimmed).
    "originalCostScale": 0.62,
    "originalStarCostScale": 0.7,
    "originalCostGemShade": 0.8,
    "originalCostOffset": [60, 6],
    "originalStarCostOffset": [50, 50],

    // A small gem on the card's top edge for a card that will be played 2 extra times, showing 2.
    // It is smaller and darker than the cost gem so it stays in the background. When the normal-cost
    // gem is showing too, it moves to replayGemOffsetWithCost, just right of the real gem.
    "replayGem": true,
    // "arrows" puts the number inside two arching arrows, the usual repeat symbol; "R" shows "R2".
    "replaySymbol": "arrows",
    // Size of the arrows and of the number inside the gem (1 = full size, 0.3 to 1.5), and how solid
    // the arrows are (0 = invisible, 1 = solid; the number stays solid).
    "replayArrowsScale": 0.78,
    "replayArrowsOpacity": 0.65,
    "replayNumberScale": 1,
    // Spin the arrows while the card is in your hand: one slow turn, then one quick turn, repeating.
    // The two times are the seconds each turn takes.
    "replayArrowsSpin": true,
    "replayArrowsSlowTurn": 3.0,
    "replayArrowsFastTurn": 0.6,
    "replayGemScale": 0.58,
    "replayGemShade": 0.7,
    "replayGemOpacity": 1.0,
    "replayGemOffset": [66, 10],
    "replayGemOffsetWithCost": [74, 34],

    // Motion on the replay gem, so it catches the eye. "ripple": every few seconds a copy of the gem
    // grows out from behind it and fades. "glow": a soft halo behind it slowly brightens and dims.
    // "compare" alternates the two along your hand, to see them side by side. "none" keeps it still.
    // Switch it in game with the dev console: idec effect ripple (or glow, compare, none).
    // All animated gems move in time together. Period is in seconds; strength runs from 0 to 2.
    // replayEffectColor is [r, g, b] from 0 to 1, e.g. [1, 0.85, 0.4] for gold; null uses the gem's colour.
    "replayEffect": "none",
    "replayEffectInHandOnly": true,
    "replayRipplePeriod": 2.4,
    "replayRippleStrength": 0.9,
    "replayGlowPeriod": 2.4,
    "replayGlowStrength": 0.8,
    "replayEffectColor": null,

    // Card edges stacked behind a card that will be played more than once, up to replayStackMax. Off by default.
    // Where each edge sits relative to the one in front ([right, down], in card units; the card is
    // 300 x 422), and how much darker each one is (0 to 0.3).
    "replayStack": false,
    "replayStackMax": 2,
    "replayStackOffset": [7, -9],
    "replayStackShade": 0.2
}
